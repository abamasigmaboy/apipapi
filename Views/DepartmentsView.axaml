<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SupplyTrackingSystem.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SupplyTrackingSystem.Views.DepartmentsView"
             x:DataType="vm:DepartmentsViewModel">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DataGrid Grid.Row="0" ItemsSource="{Binding Departments}" 
              SelectedItem="{Binding SelectedDepartment}"
              AutoGenerateColumns="False" IsReadOnly="True"
              GridLinesVisibility="All" BorderThickness="1" Margin="5">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Код" Binding="{Binding DepartmentCode}" Width="80"/>
        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="Заведующий" Binding="{Binding Manager}" Width="*"/>
        <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="150"/>
        <DataGridTextColumn Header="План (₽/день)" Binding="{Binding DailyPlan, StringFormat=N0}" Width="150"/>
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="1" Background="#fafafa" BorderBrush="#ccc" BorderThickness="1" Padding="10" Margin="5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Код:" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DepartmentCode}" IsReadOnly="True" Margin="5"/>

        <TextBlock Grid.Row="0" Grid.Column="2" Text="Наименование:" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Name}" Margin="5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Заведующий:" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Manager}" Margin="5"/>

        <TextBlock Grid.Row="1" Grid.Column="2" Text="Телефон:" VerticalAlignment="Center" Margin="5"/>
        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Phone}" Margin="5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="План (₽/день):" VerticalAlignment="Center" Margin="5"/>
        <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding DailyPlan}" 
                       Minimum="0" Increment="1000" FormatString="N0" Margin="5"/>

        <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Добавить" Command="{Binding AddCommand}" Margin="5" 
                  Background="#4CAF50" Foreground="White"/>
          <Button Content="Обновить" Command="{Binding UpdateCommand}" Margin="5"
                  IsEnabled="{Binding IsEditing}" Background="#2196F3" Foreground="White"/>
          <Button Content="Удалить" Command="{Binding DeleteCommand}" Margin="5"
                  IsEnabled="{Binding IsEditing}" Background="#f44336" Foreground="White"/>
          <Button Content="Новый" Command="{Binding NewCommand}" Margin="5"
                  Background="#757575" Foreground="White"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
