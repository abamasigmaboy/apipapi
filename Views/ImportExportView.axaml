<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SupplyTrackingSystem.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SupplyTrackingSystem.Views.ImportExportView"
             x:DataType="vm:ImportExportViewModel">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#fafafa" BorderBrush="#ccc" BorderThickness="1" Padding="20" Margin="10">
      <StackPanel Spacing="10">
        <TextBlock Text="Импорт данных" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Text="Формат:" />
        <ComboBox ItemsSource="{Binding ImportFormats}" SelectedIndex="{Binding SelectedImportFormat}" Width="300"/>

        <Button Content="Импортировать" Command="{Binding ImportCommand}" 
                Background="#4CAF50" Foreground="White" HorizontalAlignment="Left"/>

        <TextBlock Text="Результат:" FontWeight="Bold" Margin="0,10,0,0"/>
        <TextBox Text="{Binding ImportResult}" IsReadOnly="True" 
                 AcceptsReturn="True" TextWrapping="Wrap" 
                 Height="200" VerticalContentAlignment="Top"/>
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Background="#fafafa" BorderBrush="#ccc" BorderThickness="1" Padding="20" Margin="10">
      <StackPanel Spacing="10">
        <TextBlock Text="Экспорт отчётов" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Text="Отчёт:" />
        <ComboBox ItemsSource="{Binding ExportReports}" SelectedIndex="{Binding SelectedExportReport}" Width="300"/>

        <TextBlock Text="Формат:" />
        <ComboBox ItemsSource="{Binding ExportFormats}" SelectedIndex="{Binding SelectedExportFormat}" Width="300"/>

        <Button Content="Экспортировать" Command="{Binding ExportCommand}" 
                Background="#2196F3" Foreground="White" HorizontalAlignment="Left"/>

        <Button Content="Очистить все данные" Command="{Binding ClearDataCommand}" 
                Background="#f44336" Foreground="White" HorizontalAlignment="Left" Margin="0,20,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
